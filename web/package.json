{
  "name": "shipyard-dashboard",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router typegen && tsc -b && react-router build && node scripts/embed.mjs",
    "typecheck": "react-router typegen && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/lib/schema.d.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@react-router/node": "^8.4.0",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.90.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.52.2",
    "monaco-yaml": "^5.5.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
