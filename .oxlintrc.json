{
  "$schema": "./web/node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "web/src/lib/schema.d.ts",
    "web/.react-router/**",
    "web/build/**",
    "node_modules/**",
    "web/node_modules/**"
  ],
  "rules": {
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [],
        "patterns": [
          {
            "group": [
              "@/pages/*",
              "@/App",
              "@/routes/*",
              "**/route",
              "**/route.tsx",
              "**/layout",
              "**/layout.tsx",
              "!**/+types/route",
              "!**/+types/layout"
            ],
            "message": "Follow the dependency boundaries in web/AGENTS.md."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/hooks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/lib/api/call",
                "importNames": ["callApi", "callApiBlob"],
                "message": "Surface hooks call the internal API adapters."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/pages/*",
                  "@/App",
                  "@/routes/*",
                  "**/route",
                  "**/route.tsx",
                  "**/layout",
                  "**/layout.tsx",
                  "!**/+types/route",
                  "!**/+types/layout",
                  "**/components",
                  "**/components/**"
                ],
                "message": "Follow the dependency boundaries in web/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/generics/**", "**/utils/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": [
                  "@/pages/*",
                  "@/App",
                  "@/routes/*",
                  "**/route",
                  "**/route.tsx",
                  "**/layout",
                  "**/layout.tsx",
                  "!**/+types/route",
                  "!**/+types/layout",
                  "**/components",
                  "**/components/**",
                  "**/hooks",
                  "**/hooks/**"
                ],
                "message": "Follow the dependency boundaries in web/AGENTS.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["web/src/**/*.tsx"],
      "excludeFiles": ["**/hooks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/lib/api/call",
                "importNames": ["callApi", "callApiBlob"],
                "message": "Components call surface hooks."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/pages/*",
                  "@/App",
                  "@/routes/*",
                  "**/route",
                  "**/route.tsx",
                  "**/layout",
                  "**/layout.tsx",
                  "!**/+types/route",
                  "!**/+types/layout"
                ],
                "message": "Follow the dependency boundaries in web/AGENTS.md."
              }
            ]
          }
        ]
      }
    }
  ]
}
